# Server runtime configuration. Do not commit real values.
FIREBASE_API_KEY=public_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_APP_ID=1:123456789:web:example

# In production, inject this from Secret Manager into Cloud Run.
GEMINI_API_KEY=replace_me_locally_only

# Comma-separated fallback ladder. Use models actually enabled for your project.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite,gemini-flash-latest,gemini-3.7-flash
MAX_IMAGE_BYTES=10485760
PORT=8080
