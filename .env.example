# Server runtime configuration. Do not commit real values.
# In production these are supplied via env.yaml; see the README.

# --- Firebase web config (public by design, served via /api/public-config) ---
FIREBASE_API_KEY=public_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_APP_ID=1:123456789:web:example

# --- Gemini ---
# Production uses Vertex AI with the Cloud Run service account's ADC, so no
# API key is in the request path. Set GOOGLE_GENAI_USE_VERTEXAI=true there.
# Locally ADC is unavailable, so leave it unset and use the key below.
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# Local-development fallback only. In production this is injected from
# Secret Manager and left unused.
GEMINI_API_KEY=replace_me_locally_only

# Comma-separated fallback ladder. Verify these resolve for your project
# before deploying — a ladder of names that 404 is worse than one model.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-2.5-flash-lite

# --- Google Maps (Places view) ---
# Separate key from Gemini. Restrict to Maps JavaScript API and referrer-lock
# it to your deployment domain. Browser configuration, not a secret.
MAPS_BROWSER_KEY=

# --- Limits ---
MAX_IMAGE_BYTES=10485760
PORT=8080
