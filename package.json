{
  "name": "mosaic-journal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build && tsup server/index.ts --format esm --platform node --out-dir dist-server --sourcemap",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "file-type": "^20.4.1",
    "firebase": "^11.8.0",
    "firebase-admin": "^13.4.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
